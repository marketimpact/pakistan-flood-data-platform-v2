[flake8]
max-line-length = 88
extend-ignore = E203, W503, F401, F841, E501
exclude = 
    .git,
    __pycache__,
    docs/source/conf.py,
    old,
    build,
    dist,
    .venv,
    venv,
    .tox,
    .eggs,
    *.egg,
    migrations,
    settings,
per-file-ignores =
    __init__.py:F401
    */settings/*.py:F403,F405,F401
    */tests/*.py:F841,F401